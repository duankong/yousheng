{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "友声",
  "version": "0.1.5",
  "identifier": "app.duipin.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [{"label":"main","title":"友声 GroveCall","width":1150,"height":760,"minWidth":760,"minHeight":540}],
    "security": {"csp":"default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"}
  },
  "bundle": {
    "active": true,
    "homepage": "https://github.com/duankong/yousheng",
    "createUpdaterArtifacts": true,
    "useLocalToolsDir": true,
    "targets": ["nsis"],
    "icon": ["icons/app.ico"],
    "resources": ["resources/livekit-server.exe","resources/livekit-LICENSE.txt","resources/*-NOTICES.*"],
    "windows": {"nsis":{"languages":["SimpChinese","English"],"installMode":"currentUser","installerIcon":"icons/app.ico","uninstallerIcon":"icons/app.ico","installerHooks":"installer-hooks.nsh"}}
  },
  "plugins": {
    "deep-link": {"desktop":{"schemes":["duipin"]}},
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRDREM1MjIwOTAxODJFNDYKUldSR0xoaVFJRkxjVEQvSE9sM3JrZ0RFeUdGdU9WZEd5SXROT2R6Sk8xS09hMmpKelU1TFVxQlcK",
      "endpoints": ["https://github.com/duankong/yousheng/releases/latest/download/latest.json"]
    }
  }
}
